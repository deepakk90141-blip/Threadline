# Use this for a deployed backend with a separate API origin.
# VITE_API_BASE_URL=https://your-api.example.com/api

# Optional for local development when the API is on another host.
# By default the app talks to <current hostname>:8000.
# VITE_BACKEND_HOST=192.168.1.5:8000
# With Dev Tunnels, expose backend port 8000 as well; the app maps a
# frontend tunnel host ending in -5173.devtunnels.ms to the -8000 host.
